DELIMITER //

CREATE PROCEDURE sp_insert_gaji (
    IN p_nip CHAR(3),
    IN p_nama CHAR(20),
    IN p_gaji_pokok INT,
    IN p_sts_marital ENUM('K','B'),
    IN p_jam_lembur INT
)
BEGIN
    DECLARE v_gaji_lembur INT;
    DECLARE v_tunj_lembur INT;
    DECLARE v_gaji_bersih INT;

    -- Hitung gaji lembur
    SET v_gaji_lembur = p_jam_lembur * 25000;

    -- Hitung tunjangan lembur berdasarkan status
    IF p_sts_marital = 'K' THEN
        SET v_tunj_lembur = 0.05 * p_gaji_pokok;
    ELSE
        SET v_tunj_lembur = 0.025 * p_gaji_pokok;
    END IF;

    -- Hitung gaji bersih
    SET v_gaji_bersih = p_gaji_pokok + v_gaji_lembur + v_tunj_lembur;

    -- Insert ke tabel
    INSERT INTO gaji_pegawai
    VALUES (p_nip, p_nama, p_gaji_pokok, p_sts_marital, p_jam_lembur, v_gaji_bersih);

END //

DELIMITER ;
